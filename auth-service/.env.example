APP_NAME=auth-service
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=5001

DATABASE_URL=postgresql://auth:auth_secret@localhost:5434/shomal_auth

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TTL_SECONDS=604800
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=hospital-auth
JWT_AUDIENCE=hospital-gateway

OTP_TTL_SECONDS=120
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
# Dev only — never true in production (OTP goes via SMS)
OTP_DEV_RETURN_CODE=false
# Dev only — fixed OTP for manual testing (e.g. 1000). Leave empty for random.
OTP_DEV_FIXED_CODE=

# production:
# APP_ENV=production
# OTP_DEV_RETURN_CODE=false
# DEBUG=false

DEFAULT_AVATAR_URL=/static/default-avatar.svg
UPLOAD_DIR=./uploads
MAX_DOCTOR_CERTIFICATES=5

CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
